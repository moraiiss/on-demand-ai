#!/usr/bin/env bash
# Despacha uma demanda para o pipeline em uma sessão de background (worktree próprio).
# Uso: demanda [--sem-gate] [--nome slug] "descrição da demanda"
set -euo pipefail
DEMANDAS_HOME="${DEMANDAS_HOME:-$HOME/.claude/demandas}"

GATE=sim; NOME=""
while [ $# -gt 0 ]; do
  case "$1" in
    --sem-gate) GATE=nao; shift ;;
    --nome) NOME="$2"; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
TEXTO="$*"
[ -z "$TEXTO" ] && { echo "Uso: demanda [--sem-gate] [--nome slug] \"descrição\"" >&2; exit 1; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Rode dentro de um repositório git." >&2; exit 1; }
cd "$ROOT"

slugify() {
  local t
  if command -v python3 >/dev/null; then
    t="$(python3 -c 'import sys,unicodedata;print(unicodedata.normalize("NFKD",sys.argv[1]).encode("ascii","ignore").decode())' "$1")"
  else
    t="$(iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null <<<"$1" || echo "$1")"
  fi
  tr '[:upper:]' '[:lower:]' <<<"$t" | tr -cs 'a-z0-9' '-' | cut -c1-30 | sed 's/^-*//; s/-*$//'
}
SLUG="$(slugify "${NOME:-$TEXTO}")"; SLUG="${SLUG:-demanda}"
ID="DEM-$(date +%y%m%d-%H%M)-$SLUG"

mkdir -p "$DEMANDAS_HOME/ativas"
PROMPT="ID: $ID
GATE_PLANO: $GATE
REPO: $ROOT

DEMANDA:
$TEXTO"

SAIDA="$(claude --agent orquestrador --bg --permission-mode auto --name "$ID" "$PROMPT" 2>&1)" || { echo "$SAIDA" >&2; exit 1; }
echo "$SAIDA"
CURTO="$(grep -oE 'backgrounded[^0-9a-f]+[0-9a-f]{6,}' <<<"$SAIDA" | grep -oE '[0-9a-f]{6,}$' | head -n1 || true)"

printf '%s\t%s\t%s\t%s\n' "$ID" "${CURTO:--}" "$ROOT" "$(date -u +%FT%TZ)" >> "$DEMANDAS_HOME/registry.tsv"
echo
echo "✅ $ID despachada${CURTO:+ (sessão $CURTO)}. Gate do plano: $GATE"
echo "   Acompanhar: claude agents --cwd \"$ROOT\""
