[Unit]
Description=Retoma demandas do Claude Code interrompidas por limite de uso

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/vigia-limites
StandardOutput=append:%h/.claude/demandas/vigia.log
StandardError=append:%h/.claude/demandas/vigia.log
